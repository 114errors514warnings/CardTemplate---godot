<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>卡牌模拟器.Tests</RootNamespace>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用已构建好的 dll 而非 ProjectReference，避免触发主项目重编、解决 Godot SDK 中间产物冲突 -->
    <Reference Include="卡牌模拟器">
      <HintPath>..\.godot\mono\temp\bin\Debug\卡牌模拟器.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Scripts\**\*.cs" />
    <!-- 正式地图随关卡数据拷贝到测试输出目录；旧的六边形测试关（FoundationMap.json）已退役。 -->

    <None Include="..\DataBase\BattleMap\Maps\*.json" Link="BattleMap\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Equipment\Weapon.csv" Link="Weapon.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- 装备表（2026-10-02 装备界面批）：部位装备 + 装备配置（饰品格数） -->
    <None Include="..\DataBase\Equipment\Armor.csv" Link="Equipment\Armor.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Equipment\EquipmentConfig.csv" Link="Equipment\EquipmentConfig.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- 物品四表 + 掉落表（2026-10-02，批 A）：供 ItemTableFileTests 在纯 .NET 下做文件级校验 -->
    <None Include="..\DataBase\Item\Material.csv" Link="Item\Material.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Item\Item.csv" Link="Item\Item.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Item\Food.csv" Link="Item\Food.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Item\FoodRecipe.csv" Link="Item\FoodRecipe.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DataBase\Map\DropTable.csv" Link="DropTable.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
