# ============================================================
# Godot 工程
# ============================================================
# Godot 编辑器缓存（import 缓存、编辑器状态等）
.godot/

# Godot 自动生成的 UID 映射文件（每次打开工程都会重新生成）
*.uid

# Godot 翻译导入生成的二进制文件
*.translation

# Godot C# 工程打开时生成的 Language Server 缓存
*.csproj.lscache

# Godot 用户偏好（按机器保存）
.godot/global_script_class_cache.cfg

# ============================================================
# .NET / C# 构建产物
# ============================================================
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
.vscode/

# JetBrains Rider / IntelliJ
.idea/

# ============================================================
# 本仓库专属
# ============================================================
# Scripts/ 下的开发期一次性脚本（如 random_deck.js 等 Node 工具）
Scripts/*.js

# 临时调试 / 日志
*.log
*.tmp

# ============================================================
# 敏感凭证（API Key / Token / 私钥）
# ============================================================
# 严禁上传 — 已在 2026-08-30 从 git 索引移除（但历史中已存在，需 revoke）
README/AIWorkSpace/APIKey/
